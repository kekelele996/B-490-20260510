# Backend Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/counseling_db?useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=password
# Use a random secret with at least 32 characters in production.
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_32_CHAR_SECRET
JWT_EXPIRATION_SECONDS=86400
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
# URL of the backend API
BACKEND_URL=http://backend:8080

# Database Configuration
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=counseling_db
